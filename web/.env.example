# Required for live ad scrapes (never expose client-side)
APIFY_TOKEN=

# Optional actor overrides
# APIFY_SNAPCHAT_ADS_ACTOR=zadexinho/snapchat-ads-scraper
# TikTok Ads Library: residential proxies are the default integration; TLS flakes → try datacenter (`apifyProxyGroups: []`).
# APIFY_TIKTOK_USE_RESIDENTIAL=false

# Supabase (see src/lib/supabase/env.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vercel Cron: Bearer token for POST /api/cron/weekly-scrape. Set the same value in Vercel → Project Settings → Environment Variables.
CRON_SECRET=

# One-time admin ops (e.g. POST /api/admin/rescue-enrichment). Production only; generate with: openssl rand -hex 32
ADMIN_SECRET=

# Public app origin: billing redirects, auth emails when the value is trusted (real production URL).
# Must exactly match URLs allowlisted under Supabase → Authentication → URL Configuration (Site URL + Redirect URLs → …/auth/callback).
# Local dev: set http://localhost:3000 if you use a fixed port; if NEXT_PUBLIC_APP_URL is still a tutorial placeholder,
# signup / magic-link / reset links infer Host from each request so localhost testing still works until you deploy.
NEXT_PUBLIC_APP_URL=https://spy-rival.com

# Polar billing (server-only except the public app URL above).
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=a105e33c-ab82-4649-8740-c7a799f654bc
POLAR_STARTER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_SERVER=production

# Dev: show plan switcher in Settings for any authenticated user (local testing).
# ALLOW_DEV_PLAN_OVERRIDE=true

# Resend (signup confirmation, legacy magic-link, forgot-password — avoids Supabase’s built‑in auth emails).
# 1) Set RESEND_API_KEY and optionally RESEND_FROM_EMAIL (verified domain recommended).
# 2) SUPABASE_SECRET_KEY must be set so server routes can call admin.generateLink / createUser.
# If RESEND_API_KEY is unset, /signup password flow and POST /api/auth/send-password-reset return 503 (“Resend not configured”).
# Magic-link route still reports fallback: true for optional client OTP fallback.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Spy Rival <hello@spy-rival.com>"

#
# Google sign-in: enable the Google provider in Supabase Dashboard (Authentication → Providers → Google).
# In the same project, add these to Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3000/auth/callback
#   <your-production-origin>/auth/callback
# Site URL should match the app origin you use (e.g. http://localhost:3000 for local dev).

# Anthropic — Strategy Overview enrichment (Haiku), insight narratives, legacy cards; brand comparison (Sonnet).
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Strategy Map v2 spend model (deterministic). When 1, map node EUR estimates use cpm_footprint_v2; payload includes spendEstimateV2.
# STRATEGY_SPEND_ESTIMATOR_V2=1
# Optional: merge JSON partial into DEFAULT_ESTIMATOR_CONFIG (CPM tables, weights).
# STRATEGY_ESTIMATOR_CONFIG_JSON={"brandScaleSlope":0.3}
# Verbose server logs: footprint + per-platform impressions breakdown.
# STRATEGY_SPEND_ESTIMATOR_DEBUG=1

# Firecrawl discover API
FIRECRAWL_API_KEY=

# Google ad details in UI (optional)
# NEXT_PUBLIC_GOOGLE_AD_DETAILS=false

# Dev-only: legacy instant email sign-in (never enable in production).
# NEXT_PUBLIC_DEV_INSTANT_EMAIL_LOGIN=true

# Internal: show PRIMARY/MINIMAL/INACTIVE badges on Ads Library platform chips (remove before launch)
# NEXT_PUBLIC_DEBUG_PLATFORM_CLASSIFICATION=true
