# Required for live ad scrapes (never expose client-side)
APIFY_TOKEN=
# Default RAM (MB) for all Apify actor runs on upgraded plans (32GB account). Per-actor overrides: GOOGLE_ADS_MEMORY_MBYTES, META_ADS_MEMORY_MBYTES, etc.
# APIFY_ACTOR_MEMORY_MBYTES=4096

# Optional actor overrides
# APIFY_SNAPCHAT_ADS_ACTOR=zadexinho/snapchat-ads-scraper
# TikTok Ads Library: residential proxies are the default integration; TLS flakes → try datacenter (`apifyProxyGroups: []`).
# APIFY_TIKTOK_USE_RESIDENTIAL=false
# Google Transparency — residential proxies avoid Google captcha blocks (default on)
# APIFY_GOOGLE_USE_RESIDENTIAL=false

# Supabase (see src/lib/supabase/env.ts)
NEXT_PUBLIC_SUPABASE_URL=
# Client key — publishable (sb_publishable_…) preferred; legacy anon JWT also works as NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/admin key — secret (sb_secret_…) preferred; legacy service_role JWT also works as SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron: Bearer token for POST /api/cron/weekly-scrape. Set the same value in Vercel → Project Settings → Environment Variables.
CRON_SECRET=

# Optional separate secret for weekly digest unsubscribe tokens (falls back to CRON_SECRET).
# DIGEST_UNSUBSCRIBE_SECRET=

# One-time admin ops (e.g. POST /api/admin/rescue-enrichment). Production only; generate with: openssl rand -hex 32
ADMIN_SECRET=

# Public app origin: Polar/billing redirects and production auth emails.
# Must match Supabase → Authentication → URL Configuration (Site URL + Redirect URLs → …/auth/callback).
# Local dev: you can keep production here for Polar webhooks; signup, Polar checkout back/success, and billing
# portal return URLs use localhost automatically when you run `next dev` on localhost (see appOriginForRequest).
# Add http://localhost:3000/auth/callback in Supabase redirect URLs.
NEXT_PUBLIC_APP_URL=https://spy-rival.com

# Polar billing (server-only except the public app URL above).
POLAR_ACCESS_TOKEN=
# From Polar Dashboard → Settings → Webhooks (Standard Webhooks secret).
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
# Polar Dashboard webhook URL MUST use www (apex redirects with 307 and breaks delivery):
#   https://spy-rival.com/api/billing/webhook
# Product UUID from Polar → Catalogue → product row (NOT the Share/checkout link URL).
# Monthly checkout (?plan=starter|pro|agency)
POLAR_STARTER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
# Agency (multi-brand) — copy Product ID from Polar → Catalogue when ready.
POLAR_AGENCY_PRODUCT_ID=
# 100% off Pro discount for tester cohort — create in Polar Dashboard (max 10 redemptions).
POLAR_TESTER_DISCOUNT_ID=
# Tester invite (Barcelona cohort): https://spy-rival.com/invite/barcelona
# Also works: /onboarding?tester=barcelona or /signup?tester=barcelona
# Polar Checkout Link (if created manually): Success URL below; Return URL → /choose-plan
TESTER_INVITE_CODE=barcelona
TESTER_INVITE_MAX_USES=50
TESTER_INVITE_EXPIRES_AT=2026-12-31T23:59:59.000Z
# Annual checkout (?plan=starter|pro|agency&period=annual)
POLAR_STARTER_ANNUAL_PRODUCT_ID=
POLAR_PRO_ANNUAL_PRODUCT_ID=
POLAR_AGENCY_ANNUAL_PRODUCT_ID=
# Optional legacy fallback when POLAR_PRO_PRODUCT_ID is unset
POLAR_PRODUCT_ID=

# Dev: show plan switcher in Settings for any authenticated user (local testing).
# ALLOW_DEV_PLAN_OVERRIDE=true

# Resend (signup confirmation, legacy magic-link, forgot-password — avoids Supabase’s built‑in auth emails).
# 1) Set RESEND_API_KEY and optionally RESEND_FROM_EMAIL (verified domain recommended).
# 2) SUPABASE_SECRET_KEY must be set so server routes can call admin.generateLink / createUser.
# If RESEND_API_KEY is unset, /signup password flow and POST /api/auth/send-password-reset return 503 (“Resend not configured”).
# Magic-link route still reports fallback: true for optional client OTP fallback.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Spy Rival <hello@spy-rival.com>"

#
# Google sign-in: enable the Google provider in Supabase Dashboard (Authentication → Providers → Google).
# In the same project, add these to Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3000/auth/callback
#   <your-production-origin>/auth/callback
# Site URL should match the app origin you use (e.g. http://localhost:3000 for local dev).

# OpenRouter — DeepSeek V4 Flash for enrichment, narratives, brand comparison, and other LLM features.
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_HTTP_REFERER=https://spy-rival.com
OPENROUTER_APP_TITLE=Rival
OPENROUTER_CHAT_TIMEOUT_MS=120000

# Strategy Map v2 spend model (deterministic). When 1, map node EUR estimates use cpm_footprint_v2; payload includes spendEstimateV2.
# STRATEGY_SPEND_ESTIMATOR_V2=1
# Optional: merge JSON partial into DEFAULT_ESTIMATOR_CONFIG (CPM tables, weights).
# STRATEGY_ESTIMATOR_CONFIG_JSON={"brandScaleSlope":0.3}
# Verbose server logs: footprint + per-platform impressions breakdown.
# STRATEGY_SPEND_ESTIMATOR_DEBUG=1

# Firecrawl discover API
FIRECRAWL_API_KEY=

# Google ad details in UI (optional)
# NEXT_PUBLIC_GOOGLE_AD_DETAILS=false

# Local onboarding replay (after you already finished once): http://localhost:3000/onboarding?replay=1
# Reset flag via POST /api/dev/reset-onboarding (button on onboarding page in dev) or the dev panel on /login.
# Disable dev auth helpers on localhost: DEV_INSTANT_EMAIL_LOGIN=false

# Sanity CMS (blog — public read-only; set in Vercel for production /blog)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Google Tag Manager (public container id)
NEXT_PUBLIC_GTM_ID=GTM-T73R87QP

# Google Analytics 4 (gtag.js measurement id)
NEXT_PUBLIC_GA_ID=G-K7G7LYSV2J

# Meta Pixel (browser — optional override; defaults to 3206222459565978 in code)
META_PIXEL_ID=3206222459565978
NEXT_PUBLIC_META_PIXEL_ID=3206222459565978
# Meta Conversions API (server-only — required for Purchase events)
META_CAPI_TOKEN=

# PostHog (EU cloud — https://eu.posthog.com) for analytics + landing A/B tests
# Feature flag key: landing-page-hero-test-1 (variants: control | example-variant)
# Project API key / project token (phc_… — public, safe in browser):
NEXT_PUBLIC_POSTHOG_KEY=
# EU ingest host (browser uses /ingest proxy on Vercel)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional: personal API key (phx_…) for server-only admin; project token works for flags
POSTHOG_API_KEY=
