{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "web/.next",
  "crons": [
    {
      "path": "/api/cron/weekly-scrape",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/archive-killed-ads",
      "schedule": "30 5 * * 0"
    },
    {
      "path": "/api/cron/enrich-pending",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/send-alert-emails",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 2"
    },
    {
      "path": "/api/cron/organic-scrape",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/agent-weekly-brief",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/autopilot-watch",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/autopilot-report",
      "schedule": "0 6 * * *"
    }
  ]
}
