{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "web/.next",
  "crons": [
    {
      "path": "/api/cron/weekly-scrape",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/archive-killed-ads",
      "schedule": "30 5 * * 0"
    },
    {
      "path": "/api/cron/enrich-pending",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/send-alert-emails",
      "schedule": "0 */4 * * *"
    }
  ]
}
